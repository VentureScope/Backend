# =============================================================================
# VentureScope — production env for AWS EC2 (or any Ubuntu VM)
# Copy to .env on the host (never commit .env):
#   cp .env.production.example .env && nano .env
# =============================================================================

PROJECT_NAME=VentureScope
DEBUG=false
ENVIRONMENT=production

# --- Auth ---
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
TOKEN_CLEANUP_INTERVAL_SECONDS=3600
OAUTH_STATE_SECRET=REPLACE_WITH_DIFFERENT_openssl_rand_hex_32
OAUTH_STATE_EXPIRE_MINUTES=10

# --- Public URLs / CORS ---
FRONTEND_URL=https://venturescope.tech
CORS_ORIGINS=["https://venturescope.tech","https://www.venturescope.tech"]

# --- Supabase Postgres (async) ---
# Use the pooler URL with ssl=require. Keep +asyncpg for the API.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?ssl=require

# Plain URL for admin/sync queries (no +asyncpg)
SUPABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- OAuth (update redirect URIs in Google/GitHub consoles too) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.venturescope.tech/api/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://api.venturescope.tech/api/auth/oauth/github/callback

# --- LLM (GitHub Models or OpenAI-compatible) ---
END_POINT=https://models.github.ai/inference
HOSTED_LLM_TOKEN=
CHAT_MODEL_NAME=gpt-4o-mini
CHAT_MAX_TOKENS=800
CHAT_TEMPERATURE=0.7

# --- Embeddings ---
EMBEDDING_PROVIDER=hosted
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSIONS=384
# HF_TOKEN=   # only if EMBEDDING_PROVIDER=hf

# --- Serper ---
SERPER_API_KEY=

# --- Supabase Storage (S3-compatible) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
S3_BUCKET_NAME=resume
S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_ORG_BUCKET=organization
S3_PROFILE_PICTURE_BUCKET=photo

# --- Mailgun ---
EMAIL_PROVIDER=mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.venturescope.app
MAILGUN_FROM_EMAIL=noreply@mg.venturescope.app
MAILGUN_API_BASE_URL=https://api.mailgun.net/v3
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS_PER_HOUR=3

# --- Upstash Redis (OTP HTTP) ---
UPSTASH_REDIS_URL=https://YOUR-db.upstash.io
UPSTASH_REDIS_TOKEN=

# --- Celery (Upstash wire protocol TLS) ---
CELERY_BROKER_URL=rediss://default:TOKEN@YOUR-db.upstash.io:6379?ssl_cert_reqs=CERT_NONE
CELERY_RESULT_BACKEND=rediss://default:TOKEN@YOUR-db.upstash.io:6379?ssl_cert_reqs=CERT_NONE

# --- Optional (admin / ML — leave blank for MVP revival) ---
AIRFLOW_API_URL=
AIRFLOW_SERVICE_ACCOUNT_USER=
AIRFLOW_SERVICE_ACCOUNT_PASSWORD=
PIPELINE_WEBHOOK_SECRET=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=ams3
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=https://ams3.digitaloceanspaces.com
