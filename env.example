# Copy to .env and adjust
PROJECT_NAME=VentureScope
DEBUG=false

# PostgreSQL (async URL for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# JWT – generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (comma-separated or leave default)
# CORS_ORIGINS=["http://localhost:3000"]

# =============================================================================
# Configuration for user profile embeddings via Hosted LLM (OpenAI-compatible wrapper)
END_POINT=https://models.github.ai/inference
HOSTED_LLM_TOKEN=your-hosted-llm-token

# Embedding Configuration
EMBEDDING_PROVIDER=hosted  # hosted or hf
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Hugging Face (when EMBEDDING_PROVIDER=hf)
HF_TOKEN=your-hf-token

# S3 STORAGE CONFIGURATION (for CV storage)
# =============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-west-2
S3_BUCKET_NAME=your-bucket
S3_ENDPOINT_URL=https://your-project.supabase.co/storage/v1/s3

# Redis Configuration (for Celery background tasks)
# =============================================================================
# Get from Render Redis service dashboard
REDIS_URL=redis://:password@host:port
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
SERPER_API_KEY=your_serper_api_key_here
