# VentureScope Backend Environment Configuration
# Copy this file to .env and customize values for your environment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
PROJECT_NAME=VentureScope
DEBUG=false
# development, staging, production
ENVIRONMENT=development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Local development (direct connection to host PostgreSQL)
DATABASE_URL=postgresql+asyncpg://venturescope:venturescope@localhost:5432/venturescope

# Docker development (automatically used when running in docker-compose)
# Note: docker-compose.yml overrides DATABASE_URL for container networking
DOCKER_DATABASE_URL=postgresql+asyncpg://venturescope:venturescope@postgres:5432/venturescope

# Testing databases
TEST_DOCKER_DATABASE_URL=postgresql+asyncpg://venturescope:venturescope@postgres:5432/venturescope_test
TEST_DATABASE_URL=postgresql+asyncpg://venturescope:venturescope@localhost:5432/venturescope_test

# Production example (replace with your actual database URL)
# DATABASE_URL=postgresql+asyncpg://username:password@your-db-host:5432/venturescope

# =============================================================================
# JWT TOKEN CONFIGURATION
# =============================================================================
# IMPORTANT: Change this in production! Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
# 24 hours
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Token cleanup settings
# 1 hour
TOKEN_CLEANUP_INTERVAL_SECONDS=3600

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# DEVELOPMENT SETUP (Recommended)
# Allow all origins - easiest for development
CORS_ORIGINS=*

# ALTERNATIVE DEVELOPMENT SETUP
# Specify exact origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ALTERNATIVE DEVELOPMENT SETUP  
# Specify origins as JSON array
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# PRODUCTION SETUP
# CORS_ORIGINS=["https://yourapp.com","https://www.yourapp.com"]
# FRONTEND_URL=https://yourapp.com

# Primary frontend URL (fallback if CORS_ORIGINS not set in production)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# CORS BEHAVIOR BY ENVIRONMENT
# =============================================================================
# 
# DEVELOPMENT (ENVIRONMENT=development):
#   - CORS_ORIGINS=* : Allows ALL origins (recommended for dev)
#   - CORS_ORIGINS=specific : Uses only those specific origins
#   - No restrictions on localhost/dev origins
#
# PRODUCTION (ENVIRONMENT=production):
#   - CORS_ORIGINS=* : Automatically falls back to FRONTEND_URL (secure)
#   - CORS_ORIGINS=specific : Uses only those origins
#   - Automatically filters out localhost origins for security
#

# =============================================================================
# OAUTH CONFIGURATION
# =============================================================================

# Google OAuth 2.0
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Create a new project or select existing one
# 3. Enable Google+ API and OAuth consent screen
# 4. Create OAuth 2.0 credentials (Web application)
# 5. Add authorized redirect URIs: http://localhost:8000/api/auth/oauth/google/callback
# 6. Copy Client ID and Client Secret here
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback

# GitHub OAuth App
# 1. Go to GitHub Developer Settings: https://github.com/settings/developers
# 2. Create a new OAuth App
# 3. Set Authorization callback URL: http://localhost:8000/api/auth/oauth/github/callback
# 4. Copy Client ID and Client Secret here
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/oauth/github/callback

# OAuth state secret for CSRF protection
# Generate with: openssl rand -hex 32
# IMPORTANT: This should be different from your JWT SECRET_KEY
OAUTH_STATE_SECRET=your-oauth-state-secret-here

# OAuth state expiration in minutes (default: 10 minutes for security)
OAUTH_STATE_EXPIRE_MINUTES=10

# =============================================================================
# AI EMBEDDINGS CONFIGURATION
# =============================================================================
# Configuration for user profile embeddings via Hosted LLM (OpenAI-compatible wrapper)
END_POINT=https://api.openai.com/v1
HOSTED_LLM_TOKEN=your-hosted-llm-token-here

# The exact model name to use when requesting the embedding
EMBEDDING_MODEL_NAME=text-embedding-3-small

# Note: If your LLM provider returns a different dimension (e.g., 1536),
# you must either append dimensions=384 to the API call or change the
# Vector(384) schema inside the database to match!
EMBEDDING_DIMENSIONS=384

# =============================================================================
# CHAT / LLM COMPLETIONS CONFIGURATION
# =============================================================================
# Model used for the personalized chatbot (must be supported by your hosted endpoint)
CHAT_MODEL_NAME=gpt-4o-mini

# Maximum tokens the model can generate per reply
CHAT_MAX_TOKENS=800

# Sampling temperature: 0.0 = deterministic, 1.0 = very creative
CHAT_TEMPERATURE=0.7

# =============================================================================
# S3  STORAGE CONFIGURATION (for CV storage)
# =============================================================================

AWS_ACCESS_KEY_ID=your-storage-access-key
AWS_SECRET_ACCESS_KEY=your-storage-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=cvs  


S3_ENDPOINT_URL=your-s3-endpoint-url

# =============================================================================
# EMAIL / OTP CONFIGURATION
# =============================================================================

# Which email provider to use. Currently supported: mailgun
EMAIL_PROVIDER=mailgun

# Mailgun credentials
# 1. Sign up at https://www.mailgun.com/ and add a sending domain
# 2. Copy the API key from your Mailgun dashboard
MAILGUN_API_KEY=key-your-mailgun-api-key-here
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM_EMAIL=noreply@mg.yourdomain.com

# US region (default): https://api.mailgun.net/v3
# EU region:           https://api.eu.mailgun.net/v3
MAILGUN_API_BASE_URL=https://api.mailgun.net/v3

# OTP behaviour
# How long (minutes) a verification code is valid before it expires
OTP_EXPIRE_MINUTES=10

# Minimum seconds a user must wait before requesting another code
OTP_RESEND_COOLDOWN_SECONDS=60

# Maximum number of resend requests allowed per rolling hour
OTP_MAX_RESENDS_PER_HOUR=3

# =============================================================================
# UPSTASH REDIS – OTP / RATE LIMITING (HTTP-based client)
# =============================================================================
# Used by: OTP storage, resend cooldown, hourly rate-limit counters
# No TCP socket or TLS config needed – works over plain HTTPS.
#
# How to get these values:
#   1. Go to https://console.upstash.com
#   2. Create a Redis database (free tier available)
#   3. Click on the database → "REST API" tab
#   4. Copy the UPSTASH_REDIS_REST_URL  → paste as UPSTASH_REDIS_URL below
#   5. Copy the UPSTASH_REDIS_REST_TOKEN → paste as UPSTASH_REDIS_TOKEN below
#
UPSTASH_REDIS_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-redis-rest-token-here

# =============================================================================
# CELERY BROKER + RESULT BACKEND – Upstash Redis wire-protocol (rediss://)
# =============================================================================
# Used by: background embedding tasks (user profile, knowledge chunks)
# Celery requires the Redis wire protocol (TCP/TLS), not the HTTP REST API.
#
# How to get this URL:
#   1. Go to https://console.upstash.com → your database
#   2. Click "Connect" tab → select "redis-py" or "redis-cli"
#   3. Copy the connection string. It looks like:
#      rediss://default:<token>@<host>:6380
#
CELERY_BROKER_URL=rediss://default:your-upstash-redis-rest-token-here@your-db-name.upstash.io:6380
CELERY_RESULT_BACKEND=rediss://default:your-upstash-redis-rest-token-here@your-db-name.upstash.io:6380

# =============================================================================
# WEB SEARCH (Serper API)
# =============================================================================
# Used by the AI chatbot and roadmap generator to search the web.
# Get your key at: https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# =============================================================================
# SUPER-ADMIN DASHBOARD (Phase 2)
# =============================================================================

# Supabase direct read/write connection — plain psycopg2-compatible URL
# (no +asyncpg prefix — used by SupabaseService for admin dashboard queries)
# Same project as DATABASE_URL; omit ssl param for Supabase pooler
SUPABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Airflow REST API — fill in after CareerCompass is deployed
# Local dev: http://localhost:8080/api/v1
# Production (same Docker network): http://airflow-webserver:8080/api/v1
AIRFLOW_API_URL=
# Dedicated Airflow service account — create via Airflow UI: Security → Users
# Role: Op (can read dag_runs and trigger DAGs)
AIRFLOW_SERVICE_ACCOUNT_USER=backend-svc
AIRFLOW_SERVICE_ACCOUNT_PASSWORD=

# Sentry — create project at sentry.io, then:
#   Settings → Developer Settings → Internal Integrations → New Integration
#   Scopes required: project:read, org:read
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=
SENTRY_PROJECT_SLUG=
# Shared secret for verifying inbound Sentry alert webhooks (HMAC-SHA256)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SENTRY_WEBHOOK_SECRET=

# Pipeline webhook secret — CareerCompass → Backend HMAC-SHA256
# Must match PIPELINE_WEBHOOK_SECRET in CareerCompass .env exactly
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
PIPELINE_WEBHOOK_SECRET=

# DigitalOcean Spaces — ML model staging/production deploy
# Same bucket used by CareerCompass for Parquet backups
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=ams3
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=https://ams3.digitaloceanspaces.com
